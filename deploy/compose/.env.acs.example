NATS_URL=nats://__NATS_USER__:__NATS_PW__@msg_broker:4222
NATS_ENABLE_TLS="true"
CLIENT_CRT=/tmp/nats/config/cert.pem
CLIENT_KEY=/tmp/nats/config/key.pem
SERVER_CA=/tmp/nats/config/rootCA.pem

# Connection Request credentials.
# The ACS uses HTTP Digest with these credentials to authenticate to the CPE's
# Device.ManagementServer.ConnectionRequestURL when triggering a session.
#
# IMPORTANT: per TR-069 (BBF TR-069 Issue 1 Amendment 6, section 3.2.2), these
# MUST match the CPE-side parameters:
#   Device.ManagementServer.ConnectionRequestUsername
#   Device.ManagementServer.ConnectionRequestPassword
# If the CPE was provisioned with different values, the ACS will get HTTP 401
# from the CPE and Connection Request will fail.
#
# Today the ACS uses a single global pair for ALL devices and tenants. This is
# a security limitation (any leak compromises every CPE) and a feature gap.
# TODO: provision per-device random credentials during Inform via
# SetParameterValues and persist them per (tenant, SN) in NATS KV / Mongo.
CONN_RQ_USER=
CONN_RQ_PASSWD=
