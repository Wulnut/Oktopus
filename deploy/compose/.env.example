# Oktopus environment configuration
# Run ./generate-secrets.sh or use ./run.sh to auto-generate .env.* files
# with random secrets. Do NOT commit the generated .env.* files.
#
# Shared secrets (auto-generated):
#   NATS_USER / NATS_PW   - NATS broker authentication
#   JWT_SECRET            - JWT signing key (controller + firmware-upload)
#
# See generate-secrets.sh for the full list of generated files.
